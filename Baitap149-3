#include <iostream>
#include <string>
#include <vector>
using namespace std;

// ==================== LỚP NGƯỜI ====================
class Nguoi {
protected:
    string hoTen;
    int namSinh;

public:
    // Hàm tạo không đối
    Nguoi() {
        hoTen = "";
        namSinh = 0;
    }

    // Hàm tạo có đối
    Nguoi(string ho, int ns) {
        hoTen = ho;
        namSinh = ns;
    }

    // Nhập thông tin người
    void nhap() {
        cout << "Nhap ho ten: ";
        getline(cin, hoTen);

        cout << "Nhap nam sinh: ";
        cin >> namSinh;
        cin.ignore();
    }

    // Xuất thông tin người
    void xuat() const {
        cout << "Ho ten: " << hoTen << endl;
        cout << "Nam sinh: " << namSinh << endl;
    }

    // Hàm hủy
    ~Nguoi() {
    }
};


// ==================== LỚP SINH VIÊN ====================
class SinhVien : public Nguoi {
private:
    string maSinhVien;
    float diemTrungBinh;

public:
    // Hàm tạo không đối
    SinhVien() : Nguoi() {
        maSinhVien = "";
        diemTrungBinh = 0;
    }

    // Hàm tạo có đối
    SinhVien(string ho, int ns, string ma, float dtb)
        : Nguoi(ho, ns) {
        maSinhVien = ma;
        diemTrungBinh = dtb;
    }

    // Phương thức nhập sinh viên
    void nhap() {
        Nguoi::nhap();

        cout << "Nhap ma sinh vien: ";
        getline(cin, maSinhVien);

        cout << "Nhap diem trung binh: ";
        cin >> diemTrungBinh;
        cin.ignore();
    }

    // Phương thức xuất sinh viên
    void xuat() const {
        Nguoi::xuat();

        cout << "Ma sinh vien: " << maSinhVien << endl;
        cout << "Diem trung binh: " << diemTrungBinh << endl;
    }

    // Lấy điểm trung bình để sắp xếp
    float getDiemTrungBinh() const {
        return diemTrungBinh;
    }

    // Hàm hủy
    ~SinhVien() {
    }
};


// ==================== HÀM MAIN ====================
int main() {
    int n;

    cout << "Nhap so luong sinh vien: ";
    cin >> n;
    cin.ignore();

    // Khai báo danh sách sinh viên
    vector<SinhVien> ds(n);

    // Nhập danh sách
    for (int i = 0; i < n; i++) {
        cout << "\n===== NHAP SINH VIEN THU " << i + 1 << " =====" << endl;
        ds[i].nhap();
    }

    // Sắp xếp giảm dần theo điểm trung bình
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {

            if (ds[i].getDiemTrungBinh() < ds[j].getDiemTrungBinh()) {
                SinhVien temp = ds[i];
                ds[i] = ds[j];
                ds[j] = temp;
            }
        }
    }

    // In danh sách sau khi sắp xếp
    cout << "\n========== DANH SACH SINH VIEN ==========" << endl;

    for (int i = 0; i < n; i++) {
        cout << "\n--- Sinh vien thu " << i + 1 << " ---" << endl;
        ds[i].xuat();
    }

    return 0;
}
